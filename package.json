    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-bgtwn",
    "ExpoBgtwn",
    "beginBackgroundTask",
    "background-task"
  ],
  "repository": "https://github.com/Acetyld/expo-bgtwn",
  "bugs": {
    "url": "https://github.com/Acetyld/expo-bgtwn/issues"
  },
  "author": "Dion <dion@vitrion.nl> (https://github.com/Acetyld)",
  "license": "MIT",
  "homepage": "https://github.com/Acetyld/expo-bgtwn#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.23",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "^3.0.0",
    "react-native": "0.86.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "expo-modules-core": "*"
  }
